node_modules/
dist/
.astro/
.tmp.*.md
.tmp.*
*.log
site/public/studies/
site/dist/
site/node_modules/
site/.astro/

# Playwright MCP snapshots — accessibility trees + screenshots. Capture verbatim
# DOM including any tokens/passwords shown in-page (e.g., Zenodo PAT display
# page, OAuth signup forms). Local-only, never committed.
.playwright-mcp/

# Compile:study composite manuscripts land at studies/<slug>/<slug>-vN.N.md.
# Per design v7.1 §7.1 + canonical-chapters memory: these are RELEASE-ONLY
# derived artifacts. Chapter files are canonical; composites regen from them.
# Never commit the composite from the study root.
studies/*/*-v*.md

# Derived on every build by scripts/version.mjs (contains git short SHA).
# Site build's prebuild hook (npm run version:generate) regenerates.
# Committing the file makes every build produce a git-status dirty file.
site/src/version.generated.mjs
site/src/version.generated.ts

# Local health-check output — regenerated on every run
data/last-health-check.json
