{
  "name": "lemma-site",
  "type": "module",
  "version": "0.3.0",
  "private": true,
  "description": "Astro Starlight site for lemma theological studies (site chrome only; canonical content lives at ../studies/)",
  "scripts": {
    "version:generate": "node ../scripts/version.mjs",
    "dev": "npm run version:generate && astro dev",
    "start": "npm run version:generate && astro dev",
    "build": "npm run version:generate && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.37.6",
    "astro": "^5.6.1",
    "sharp": "^0.34.2",
    "starlight-giscus": "^0.8.1"
  },
  "devDependencies": {
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "fast-glob": "^3.3.2",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "sass": "^1.77.0",
    "vitest": "^2.0.0"
  }
}
